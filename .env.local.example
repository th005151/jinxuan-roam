# --- Site ---
NEXT_PUBLIC_SITE_URL=https://jinxuan-roam.vercel.app
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# --- Notion sync (required for `npm run sync` / Vercel build) ---
# Internal integration token from https://notion.so/profile/integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Notion database ID (32-char hex from the database URL)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Affiliate partner outbound URLs ---
# Set only the partners you have accounts with. Missing env = silent fallback (no CTA).
AFFILIATE_KLOOK=https://www.klook.com/?aid=YOUR_ID
AFFILIATE_TRIP=https://www.trip.com/?aid=YOUR_ID
AFFILIATE_KKDAY=https://www.kkday.com/?aid=YOUR_ID
AFFILIATE_AGODA=https://www.agoda.com/?cid=YOUR_ID
AFFILIATE_BOOKING=https://www.booking.com/?aid=YOUR_ID
AFFILIATE_EXPEDIA=https://www.expedia.com/?camref=YOUR_ID
